# 统一换行符为 LF，避免 macOS / Linux 上脚本因 CRLF 报错
* text=auto eol=lf

*.sh      text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.swift   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.py      text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary

# Gradle Wrapper：脚本 LF（macOS/Linux 直接可执行），批处理 CRLF，jar 二进制
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.jar          binary
